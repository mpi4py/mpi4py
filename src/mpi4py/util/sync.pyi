import sys
from collections.abc import Callable
from typing import Generic, Literal

if sys.version_info >= (3, 11):
    from typing import Self
else:
    from typing_extensions import Self

from ..MPI import (
    COMM_SELF,
    INFO_NULL,
    Info,
    Intracomm,
    Op,
)
from ..typing import Number, T

__all__: list[str] = [
    "Sequential",
    "Value",
    "Counter",
    "Mutex",
    "Condition",
    "Semaphore",
    "Event",
]

class Sequential:
    comm: Intracomm
    tag: int
    def __init__(
        self,
        comm: Intracomm,
        tag: int = 0,
    ) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...
    def begin(self) -> None: ...
    def end(self) -> None: ...

class Value(Generic[Number]):
    def __init__(
        self,
        typecode: str,
        value: Number = 0,
        *,
        comm: Intracomm = COMM_SELF,
        info: Info = INFO_NULL,
        root: int = 0,
    ) -> None: ...
    value: Number
    @property
    def typecode(self) -> str: ...
    def compare_and_swap(self, value: Number, compare: Number) -> Number: ...
    def accumulate(self, value: Number, op: Op) -> None: ...
    def fetch_and_op(self, value: Number, op: Op) -> Number: ...
    def fetch_and_set(self, value: Number) -> Number: ...
    def fetch_and_add(self, value: Number) -> Number: ...
    def get(self) -> Number: ...
    def set(self, value: Number) -> None: ...
    def add(self, value: Number) -> None: ...
    def free(self) -> None: ...

class Counter(Generic[Number]):
    def __init__(
        self,
        start: Number = 0,
        step: Number = 1,
        *,
        typecode: str = "i",
        comm: Intracomm = COMM_SELF,
        info: Info = INFO_NULL,
        root: int = 0,
    ) -> None: ...
    def __iter__(self) -> Self: ...
    def __next__(self) -> Number: ...
    def next(self, incr: Number | None = None) -> Number: ...
    def reset(self, init: Number | None = None) -> Number: ...
    def free(self) -> None: ...

class Mutex:
    def __init__(
        self,
        *,
        recursive: bool = False,
        comm: Intracomm = COMM_SELF,
        info: Info = INFO_NULL,
    ) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...
    def acquire(self, blocking: bool = True) -> bool: ...
    def release(self) -> None: ...
    def owned(self) -> bool: ...
    def locked(self) -> bool: ...
    def count(self) -> int: ...
    def free(self) -> None: ...

class Condition:
    def __init__(
        self,
        mutex: Mutex | None = None,
        *,
        recursive: bool = True,
        comm: Intracomm = COMM_SELF,
        info: Info = INFO_NULL,
    ) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...
    def acquire(self, blocking: bool = True) -> bool: ...
    def release(self) -> None: ...
    def owned(self) -> bool: ...
    def locked(self) -> bool: ...
    def wait(self) -> Literal[True]: ...
    def wait_for(self, predicate: Callable[[], T]) -> T: ...
    def notify(self, n: int = 1) -> int: ...
    def notify_all(self) -> int: ...
    def free(self) -> None: ...

class Semaphore:
    def __init__(
        self,
        value: int = 1,
        *,
        bounded: bool = True,
        comm: Intracomm = COMM_SELF,
        info: Info = INFO_NULL,
    ) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...
    def acquire(self, blocking: bool = True) -> bool: ...
    def release(self, n: int = 1) -> None: ...
    def free(self) -> None: ...

class Event:
    def __init__(
        self,
        *,
        comm: Intracomm = COMM_SELF,
        info: Info = INFO_NULL,
        root: int = 0,
    ) -> None: ...
    def is_set(self) -> bool: ...
    def set(self) -> None: ...
    def clear(self) -> None: ...
    def wait(self) -> bool: ...
    def free(self) -> None: ...
